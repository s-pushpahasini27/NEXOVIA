APP_ORIGIN=http://127.0.0.1:8000
HOST=127.0.0.1
PORT=8000
ALLOW_LOCAL_DEV=true
# Defaults to the project's data/ folder. Use an absolute path to move it.
# NEXOVIA_DATA_DIR=C:/Users/YourName/NexoviaData

# Optional Google OAuth web application credentials. Never commit real secrets.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# Optional live AI for the study planner, tutor chat, quizzes and flashcards.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set only after confirming image-model access and any provider costs.
# Example compatible model: gemini-2.5-flash-image. No automatic model switch.
GEMINI_IMAGE_MODEL=

# Required for email/password signup and verification of legacy accounts.
# Use an existing email provider. No paid service is created by Nexovia.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional server-wide OTP signing key (32+ characters). Without it a private
# persistent key is generated at data/secrets/otp.key; preserve this directory.
AUTH_OTP_SECRET=

# Application request limits; these do not change the provider's billing plan.
AI_REQUESTS_PER_USER_HOUR=30
AI_REQUESTS_PER_HOUR=300

# Optional existing coturn-compatible relay using time-limited REST credentials.
# Do not enable a paid relay without the project owner's approval.
TURN_URLS=
TURN_SECRET=
